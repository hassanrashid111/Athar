{
  "rules": {

    /* ========================================================
       👤 بيانات المستخدمين وإدارة الصلاحيات
       - القراءة: أي مستخدم مسجل (لقراءة الملف الشخصي وقوائم المشرفين)
       - الكتابة: المستخدم نفسه لملفه، أو Super Admin للتحكم بكافة الحسابات
       ======================================================== */
    "users": {
      ".read": "auth != null",
      ".write": "auth != null && auth.token.email === 'hrhalsharif@gmail.com'",
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null && ($uid === auth.uid || auth.token.email === 'hrhalsharif@gmail.com' || root.child('users/'+auth.uid+'/role').val() === 'group_supervisor')"
      }
    },

    /* ========================================================
       🏫 مجموعات أثر (الهيكل القائم)
       ======================================================== */
    "athar_groups": {
      ".read": "auth != null",
      "$group_id": {
        ".read": "auth != null",
        ".write": "auth != null",
        "info": {
          ".read": "auth != null",
          ".write": "auth != null"
        },
        "data": {
          ".read": "auth != null",
          ".write": "auth != null"
        },
        "students": {
          ".read": "auth != null",
          "$supervisor_uid": {
            ".write": "auth != null && ($supervisor_uid === auth.uid || root.child('users/'+auth.uid+'/role').val() === 'group_supervisor')"
          }
        },
        "transfers": {
          ".read": "auth != null",
          ".write": "auth != null"
        },
        "responses": {
          ".read": "auth != null",
          ".write": true
        }
      }
    },

    /* ========================================================
       ⚙️ الإعدادات العامة المشتركة (Global Settings)
       - القراءة: مفتوحة للجميع (لفحص system_status في شاشة الهبوط قبل تسجيل الدخول)
       - الكتابة: المستخدمين المسجلين (Super Admin لتغيير الحالة، والمشرفين لإضافة أسباب الانسحاب)
       ======================================================== */
    "global_settings": {
      ".read": true,
      ".write": "auth != null"
    },

    /* ========================================================
       📊 مقاييس النظام (System Analytics)
       - القراءة والكتابة: أي مستخدم مسجّل (تتبع موزع لعمليات AI والأوفلاين والشهادات)
       ======================================================== */
    "system_analytics": {
      ".read": "auth != null",
      ".write": "auth != null"
    },

    /* ========================================================
       🗂️ أرشيف الدورات (Epochs)
       - القراءة: أي مستخدم مسجّل
       - الكتابة: المشرف العام أو Super Admin
       ======================================================== */
    "epochs": {
      ".read": "auth != null",
      ".write": "auth != null && (auth.token.email === 'hrhalsharif@gmail.com' || root.child('users/'+auth.uid+'/role').val() === 'group_supervisor')"
    },

    /* ========================================================
       📩 طلبات الديمو (Demo Requests)
       - القراءة والكتابة: مفتوحة (الزوار غير المسجلين يرسلون طلبات)
       ======================================================== */
    "demo_requests": {
      ".read": "auth != null",
      ".write": true
    }

  }
}

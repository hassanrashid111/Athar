{
  "database": {
    "rules": "database.rules.json"
  },
  "hosting": {
    "site": "athar-final1",
    "public": "public",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "cleanUrls": true,
    "headers": [
      {
        "source": "/(version.json|sw.js)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      }
    ],
    "rewrites": [
      { "source": "/login",       "destination": "/login.html" },
      { "source": "/setup",       "destination": "/setup.html" },
      { "source": "/dashboard",   "destination": "/dashboard.html" },
      { "source": "/reports",     "destination": "/reports.html" },
      { "source": "/presentation","destination": "/presentation.html" },
      { "source": "/guide",       "destination": "/presentation.html" },
      { "source": "/super-admin", "destination": "/super_admin.html" }
    ]
  }
}